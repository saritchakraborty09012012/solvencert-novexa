# SolveNCERT environment variables — names only, fill in your own values.
# Copy to .env.local:   cp .env.example .env.local
# .env.local is gitignored. Never commit real values.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (at least one provider key is required)
GEMINI_API_KEY=
GEMINI_FLASHCARD_KEY=
GROQ_API_KEY=
GROQ_AI_SEARCH_KEY=
GROQ_PAYMENT_VERIFY_KEY=

# Search (optional — falls back to local search if unset)
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Contact form (optional — Resend)
RESEND_API_KEY=
CONTACT_EMAIL=

# SEO (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
